<UserControl x:Class="ElectronicMaps.WPF.Features.Workspace.Details.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:params="clr-namespace:ElectronicMaps.WPF.Features.Workspace.Parameters"
             xmlns:local="clr-namespace:ElectronicMaps.WPF.Features.Workspace.Details"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- НДТ строки -->
        <DataTemplate x:Key="NdtRowTemplate">


                <TextBlock Grid.Column="0"
                           Text="{Binding StringValue, TargetNullValue='—'}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap"/>

               
        </DataTemplate>

        <!-- Редактируемая строка параметра (Schematic — вносит пользователь) -->
        <DataTemplate x:Key="SchematicRowTemplate"
                      DataType="{x:Type params:ParameterValueRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         FontSize="12"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Unit}"
                           VerticalAlignment="Center"
                           Opacity="0.5"
                           FontSize="11"/>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />            <!-- Заголовок компонента -->
            <RowDefinition Height="Auto" />            <!-- Заголовки колонок -->
            <RowDefinition Height="*" />            <!-- Список параметров -->
            <RowDefinition Height="Auto" />            <!-- Кнопки + статус -->
        </Grid.RowDefinitions>

        <!-- Заголовок компонента -->
        <Border Grid.Row="0"
                Padding="0,0,0,12"
                BorderBrush="{DynamicResource DataGridBorder}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding ComponentName}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FormName}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Заголовки колонок -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <!-- Название параметра -->
                <ColumnDefinition Width="*" />
                <!-- NDT (из БД) -->
                <ColumnDefinition Width="*" />
                <!-- Схема (редактируемая) -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Параметр"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="По даташиту"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text=" (из БД)"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Opacity="0.6" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="В схеме"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}" />
                <TextBlock Text=" (редактировать)"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Opacity="0.6" />
            </StackPanel>
        </Grid>

        <!-- Список параметров -->
        <!-- Список параметров -->
        <ScrollViewer Grid.Row="2"
              VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar"
               BasedOn="{StaticResource MinimalScrollBar}" />
            </ScrollViewer.Resources>

            <Grid>
                <!-- Empty state -->
                <TextBlock Text="Нет параметров для этой формы"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,24,0,0"
                   Visibility="{Binding ParameterRows.Count,
                                Converter={StaticResource CountToVisibilityConverter}}" />

                <!-- Строки параметров -->
                <ItemsControl ItemsSource="{Binding ParameterRows}"
                      Visibility="{Binding IsReady,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ParameterRowPair}">
                            <Border BorderBrush="{DynamicResource DataGridBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                       Text="{Binding Ndt.DisplayName}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}" />

                                    <ContentControl Grid.Column="1"
                                            Content="{Binding Ndt}"
                                            ContentTemplate="{StaticResource NdtRowTemplate}"
                                            IsEnabled="False"
                                            Margin="8,0" />

                                    <ContentControl Grid.Column="2"
                                            Content="{Binding Schematic}"
                                            ContentTemplate="{StaticResource SchematicRowTemplate}"
                                            Margin="8,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Кнопки + статус -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource DataGridBorder}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Статус -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Кнопки -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Отмена"
                            Command="{Binding DiscardCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button Content="Применить"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
