<UserControl x:Class="ElectronicMaps.WPF.Features.Workspace.FormCards.ComponentCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ElectronicMaps.WPF.Features.Workspace.FormCards"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- Единый стиль для всех карточек -->
    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="2"
            CornerRadius="6"
            Padding="16,12">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Style.Triggers>
                    <!--Hover-->
                    <DataTrigger Binding="{Binding IsDetailsOpen}" Value="False">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                    </DataTrigger>
                    <!-- Активная карточка (панель деталей открыта) -->
                    <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundHover}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource CardBorderHover}" />
                        <Setter Property="Background"
                                Value="{DynamicResource CardBackgroundHover}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>            <!--Индикатор авктивности -->
                <ColumnDefinition Width="Auto" />                <!-- Номер -->
                <ColumnDefinition Width="*" />                <!-- Информация -->
                <ColumnDefinition Width="Auto" />               <!-- Количество -->
                <ColumnDefinition Width="Auto" />               <!-- Кнопки -->
            </Grid.ColumnDefinitions>
            
            <!-- Индикатор активности -->
            <Border Grid.Column="0"
                    Width="3"
                    CornerRadius="2"
                    Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Номер (минималистично) -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Number}"
                       FontSize="13"
                       Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       MinWidth="24" />

            <!-- Основная информация -->
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <!-- Название -->
                <TextBlock Text="{Binding Name}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" />

                <!-- Позиционные обозначения -->
                <TextBlock Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Designators, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Количество (минималистично) -->
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource TextSecondary}">
                <Run Text="{Binding Quantity, Mode=OneWay}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource TextPrimary}" />
                <Run Text=" шт." />
            </TextBlock>
            
            <!-- Кнопки открытия деталей -->
            <Button Grid.Column="4"
                    Command="{Binding ToggleDetailsCommand}"
                    CommandParameter="{Binding Id}"
                    Width="28" Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    ToolTip="Открыть детали">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <!-- Стрелка: → когда закрыто, ← когда открыто -->
                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="→" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                    <Setter Property="Text" Value="←" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
                    
            
            
        </Grid>
    </Border>
</UserControl>
